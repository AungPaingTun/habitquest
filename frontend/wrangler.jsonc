{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "habitquest",
  "compatibility_date": "2026-10-02",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    // Unknown paths like /stats get index.html, so React Router handles them.
    "not_found_handling": "single-page-application",
    // /api/* skips the static files and goes to the Worker, which forwards it to Heroku.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://habitquest-api-35269eb9ad8d.herokuapp.com"
  },
  "routes": [
    // The root domain and www belong to the portfolio Worker (repo: AungPaingTun/portfolio).
    { "pattern": "habitquest.aungpaingtun.dev", "custom_domain": true }
  ]
}
